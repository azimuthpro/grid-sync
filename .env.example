# GridSync environment
# Copy to .env.local. Values are validated at startup by src/lib/Env.mjs.

# Supabase
# Local: run `supabase start` and copy the values from `supabase status`
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Hosted: Project Settings > API Keys (publishable and secret keys; legacy anon/service_role keys are disabled)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: bypasses RLS, used by the insolation import
SUPABASE_SECRET_KEY=sb_secret_...

# Google Gemini (insolation map parsing)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Shared secret for /api/cron/fetch-insolation (sent as Authorization: Bearer <secret>)
CRON_SECRET=any_long_random_string
